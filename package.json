{
  "name": "jasonstu-apps-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_WRITE_LOGS=false WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_WRITE_LOGS=false WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_WRITE_LOGS=false WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern worker-configuration.d.ts",
    "typecheck": "npm run cloudflare:types && tsc --noEmit",
    "cloudflare:types": "wrangler types worker-configuration.d.ts --env-interface CloudflareEnv",
    "cloudflare:types:check": "wrangler types worker-configuration.d.ts --env-interface CloudflareEnv --check",
    "cloudflare:dry-run": "vinext-cloudflare deploy --config wrangler.jsonc --dry-run",
    "cloudflare:dry-run:beta": "vinext-cloudflare deploy --config wrangler.jsonc --env beta --dry-run",
    "cloudflare:deploy:production": "vinext-cloudflare deploy --config wrangler.jsonc",
    "cloudflare:deploy:beta": "vinext-cloudflare deploy --config wrangler.jsonc --env beta"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.3",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vinext/cloudflare": "1.0.0-beta.2",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.128.0"
  },
  "type": "module"
}
